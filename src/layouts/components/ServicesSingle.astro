---
import { render } from "astro:content";
import { getLocaleUrlCTM } from "@/lib/utils/i18nUtils";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import ImageList from "@/components/ImageList.astro";
import ImageItem from "@/components/ImageItem.astro";

const {
  data: { 
    title, 
    description,
    image,
    ventajas,
    proceso,
    impacto,
    soluciones_title,
    soluciones_text,
    soluciones_features,
    soluciones_images
  },
} = Astro.props.content;

const { Content } = await render(Astro.props.content);

// Fallbacks para que nunca haya bloques vacíos
const displayVentajas = ventajas && ventajas.length > 0 ? ventajas : [
  { title: "Sinergia Operativa", description: "Integración perfecta en cada etapa de tu supply chain.", icon: "" },
  { title: "Visibilidad 360°", description: "Control en tiempo real con tecnología predictiva.", icon: "" },
  { title: "Reducción de Riesgo", description: "Protocolos estrictos de seguridad y cumplimiento normativo.", icon: "" },
  { title: "Agilidad", description: "Respuestas dinámicas ante retos logísticos globales.", icon: "" }
];

const displayProceso = proceso && proceso.length > 0 ? proceso : [
  { step: "01", title: "Análisis Consultivo", description: "Evaluamos su ecosistema logístico para diseñar una estrategia a medida." },
  { step: "02", title: "Ingeniería de Rutas", description: "Optimizamos trayectos y modalidades para máxima eficiencia." },
  { step: "03", title: "Ejecución Milimétrica", description: "Implementación del plan con monitoreo satelital continuo." },
  { step: "04", title: "Entrega y Reporte", description: "Confirmación en destino y reporte de KPIs operativos." }
];

const displaySolucionesFeatures = soluciones_features && soluciones_features.length > 0 ? soluciones_features : [
  { title: "Estructura Dedicada", description: "Capacidad reservada para operaciones críticas." },
  { title: "Optimización Inteligente", description: "Reducción de costos ocultos mediante analítica." }
];

// Garantizar imágenes: Si el usuario define soluciones_images en el .md, se usan esas.
// Si no, por ahora lo dejamos vacío o usamos la imagen principal repetida según prefiera el diseño inicial.
const displayImages = (soluciones_images && soluciones_images.length > 0) 
  ? soluciones_images 
  : (image ? [
      image.replace(/(\.[^.]+)$/, '2$1'), 
      image.replace(/(\.[^.]+)$/, '3$1')
    ] : []);
---

<div class="service-page relative w-full m-0 p-0 font-sans selection:bg-yellow-400 selection:text-[#0a192f] overflow-hidden bg-white">
    
    <!-- BLOCK 1: Hero Asimétrico Vanguardista (AZUL) -->
    <section class="relative w-full py-16 lg:py-[100px] overflow-hidden border-b border-white/5 bg-[#0a192f] text-slate-300">
      <!-- Decoración tipográfica de fondo -->
      <div class="absolute -top-10 -right-10 text-[20vw] font-black text-white/3 leading-none pointer-events-none select-none uppercase z-0 break-words w-screen mix-blend-overlay">
        {title || 'Servicio'}
      </div>

      <div class="container relative z-20 flex flex-col lg:flex-row gap-8 lg:gap-16 items-center">
        
        <div class="w-full lg:w-3/5 order-2 lg:order-1 relative">
           <a href={getLocaleUrlCTM("/services", Astro.currentLocale)} class="inline-flex items-center gap-3 text-xs font-bold text-yellow-500 uppercase tracking-[0.2em] hover:text-white transition-colors mb-6 group">
              <span class="w-8 h-[2px] bg-yellow-500 group-hover:w-12 group-hover:bg-white transition-all"></span> Volver
           </a>
           <h1 class="text-4xl md:text-6xl lg:text-7xl font-black text-white mb-6 leading-[0.95] tracking-tighter" set:html={title} />
           
           <p class="text-base md:text-lg font-light text-slate-400 max-w-xl leading-relaxed mb-8 border-l-2 border-yellow-500 pl-5">
              {description}
           </p>

           <div class="flex items-center gap-8">
              <a href="#soluciones" class="text-white hover:text-yellow-400 font-bold uppercase tracking-widest text-sm transition-colors flex items-center gap-2 group">
                 Explorar
                 <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-2 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </a>
           </div>
        </div>

        <!-- Imagen Asimétrica Reducida -->
        {image && (
          <div class="w-full lg:w-2/5 order-1 lg:order-2 h-[25vh] lg:h-[35vh] relative group overflow-hidden rounded-3xl lg:rounded-bl-[60px] lg:rounded-tr-[60px] shadow-lg border border-white/10">
             <div class="absolute inset-0 bg-[#0a192f]/20 mix-blend-multiply z-10 group-hover:bg-transparent transition-colors duration-700"></div>
             <OptimizedImage src={image} alt={title || 'Servicio'} width={800} height={600} class="h-full w-full object-cover scale-105 group-hover:scale-100 transition-transform duration-1000 ease-out grayscale-[20%] group-hover:grayscale-0" />
          </div>
        )}
      </div>
    </section>

    <!-- Marquee de impacto -->
    <div class="w-full bg-yellow-400 text-[#0a192f] py-3 overflow-hidden flex whitespace-nowrap">
       <div class="animate-[marquee_20s_linear_infinite] flex gap-12 items-center text-sm font-black uppercase tracking-[0.3em]">
          <span>Logística Integral</span> <span>•</span> <span>Innovación</span> <span>•</span> <span>Conexión Global</span> <span>•</span> <span>Seguridad</span> <span>•</span>
          <span>Logística Integral</span> <span>•</span> <span>Innovación</span> <span>•</span> <span>Conexión Global</span> <span>•</span> <span>Seguridad</span> <span>•</span>
          <span>Logística Integral</span> <span>•</span> <span>Innovación</span> <span>•</span> <span>Conexión Global</span> <span>•</span> <span>Seguridad</span> <span>•</span>
       </div>
    </div>

    <!-- BLOCK 2: Bento Grid (BLANCO / GRIS CLARO) -->
    <section class="py-20 md:py-28 relative z-10 bg-slate-50 border-b border-slate-200">
      <div class="container px-4">
        <div class="mb-14 md:mb-20 flex flex-col md:flex-row gap-8 justify-between items-end">
          <h2 class="text-4xl md:text-5xl lg:text-6xl font-black text-[#0a192f] leading-none tracking-tighter">Nuestra<br/><span class="text-transparent bg-clip-text bg-linear-to-r from-yellow-500 to-yellow-600">Ventaja Competitiva</span></h2>
          <p class="text-slate-600 max-w-sm text-left md:text-right font-light">Métricas y metodologías que transforman tu cadena de valor en un activo estratégico.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 grid-rows-2 gap-4 md:gap-6 lg:h-[500px]">
          {displayVentajas.map((v: any, i: number) => {
             // Bento layout logic
             let colSpan = "md:col-span-1";
             let rowSpan = "md:row-span-1";
             if (i === 0) { colSpan = "md:col-span-2"; rowSpan = "md:row-span-2"; }
             else if (i === 1) { colSpan = "md:col-span-2"; }
             
             return (
              <div class={`relative rounded-3xl overflow-hidden bg-white border border-slate-200 p-8 flex flex-col justify-end group transition-all duration-500 hover:bg-slate-50 hover:border-yellow-400 hover:shadow-xl ${colSpan} ${rowSpan}`}>
                <div class="absolute top-8 right-8 text-slate-200 group-hover:text-yellow-500/80 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="m12 16 4-4-4-4"></path><path d="M8 12h8"></path></svg>
                </div>
                
                <h3 class={`font-black text-[#0a192f] mb-3 ${i === 0 ? 'text-3xl lg:text-4xl' : 'text-xl lg:text-2xl'}`}>{v.title}</h3>
                <p class={`text-slate-600 font-light ${i === 0 ? 'text-lg max-w-sm' : 'text-sm'}`}>{v.description}</p>
              </div>
            )
          })}
        </div>
      </div>
    </section>

    <!-- BLOCK 3: Metodología Interactiva (AZUL OSCURO) -->
    <section class="py-20 md:py-28 bg-[#0a192f] relative text-white">
      <div class="container px-4 block lg:flex gap-16">
        
        <!-- Sticky Header (Left) -->
        <div class="w-full lg:w-1/3 mb-16 lg:mb-0 relative">
          <div class="sticky top-32">
            <h2 class="text-4xl md:text-5xl font-black text-white mb-6 tracking-tighter uppercase leading-[0.9]">El <br/><span class="text-yellow-400">Proceso</span></h2>
            <p class="text-slate-400 border-l border-white/20 pl-5 py-2 font-light">
              Arquitectura operativa diseñada para predecir, gestionar y ejecutar con absoluta claridad en cada fase.
            </p>
          </div>
        </div>

        <!-- Scrolling Steps (Right) -->
        <div class="w-full lg:w-2/3 flex flex-col gap-10 lg:gap-20 relative">
          {displayProceso.map((p: any) => (
            <div class="flex gap-6 lg:gap-10 items-start opacity-70 hover:opacity-100 transition-opacity duration-500 group">
              <div class="shrink-0 text-5xl lg:text-7xl font-black text-transparent bg-clip-text bg-linear-to-b from-white/20 to-transparent group-hover:from-yellow-400 group-hover:to-yellow-600/50 transition-all font-mono">
                {p.step}
              </div>
              <div class="pt-2 lg:pt-4">
                <h4 class="text-2xl lg:text-3xl font-bold text-white mb-3 tracking-tight">{p.title}</h4>
                <p class="text-slate-400 text-base md:text-lg font-light leading-relaxed">{p.description}</p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- BLOCK 4: Soluciones a Medida (BLANCO) -->
    <section id="soluciones" class="py-20 md:py-28 relative overflow-hidden bg-white border-t border-slate-200">
      <div class="container px-4">
        <div class="flex flex-col lg:flex-row gap-12 lg:gap-8 items-start lg:items-center">
          
          <!-- Left: Texto & Features -->
          <div class="w-full lg:w-1/2 pr-0 lg:pr-12 relative z-10">
            <h2 class="text-4xl lg:text-5xl font-black text-[#0a192f] mb-8 tracking-tighter leading-none">
              {soluciones_title || 'Enfoque Integral'}
            </h2>
            <p class="text-slate-600 text-lg md:text-xl font-light mb-12 leading-relaxed">
              {soluciones_text}
            </p>
            
            <div class="space-y-6">
              {displaySolucionesFeatures.map((feat: any) => (
                <div class="border-t border-slate-200 pt-5">
                  <h4 class="text-xl font-bold text-[#0a192f] mb-2 flex items-center gap-3">
                     <span class="w-2 h-2 bg-yellow-400 rounded-full"></span>
                     {feat.title}
                  </h4>
                  <p class="text-slate-600 font-light pl-5">{feat.description}</p>
                </div>
              ))}
            </div>
 
            <!-- Markdown Content -->
            {Content && (
               <div class="mt-14 prose prose-base md:prose-lg max-w-none prose-headings:font-black prose-headings:text-[#0a192f] prose-headings:tracking-tighter prose-a:text-yellow-600 prose-p:font-light prose-p:text-slate-600">
                  <Content components={{ ImageItem, ImageList }} />
               </div>
            )}
          </div>
 
          <!-- Right: Imágenes Dinámicas -->
          {displayImages && displayImages.length > 0 && (
            <div class="w-full lg:w-1/2 flex flex-col items-center lg:items-start relative lg:min-h-[600px] mt-16 lg:mt-0">
               <div class="relative w-full max-w-md mx-auto">
                  {displayImages.map((img: string, i: number) => {
                     const isFirst = i === 0;
                     
                     return (
                     <div class={`shadow-lg transition-all duration-700 hover:z-30 hover:scale-105 border border-slate-200 bg-slate-100 overflow-hidden
                        ${isFirst 
                          ? 'relative lg:absolute w-[80%] md:w-[85%] aspect-[4/5] lg:top-0 lg:right-0 z-20 rounded-3xl lg:rounded-tr-[60px] lg:rounded-bl-[60px] ml-auto' 
                          : 'relative lg:absolute w-[70%] md:w-[75%] aspect-[3/4] lg:bottom-0 lg:left-0 z-10 rounded-2xl lg:rounded-tl-[50px] lg:rounded-br-[50px] -mt-12 lg:mt-0 lg:-translate-y-8 ml-4 lg:ml-0'
                        }`}>
                        <div class="absolute inset-0 bg-[#0a192f]/5 mix-blend-color z-10 hover:opacity-0 transition-opacity"></div>
                        <OptimizedImage src={img} alt="Operación" width={600} height={800} class="h-full w-full object-cover grayscale-15 hover:grayscale-0" />
                     </div>
                     )
                  })}
               </div>
            </div>
          )}
          
        </div>
      </div>
    </section>

    <!-- BLOCK 5: CTA de Impacto (AZUL OSCURO para cerrar la página sin dejar blancos) -->
    <section class="cta-section py-24 md:py-32 relative border-t border-slate-200 overflow-hidden bg-[#0a192f] w-full mb-0 pb-32">
      <!-- Decoraciones sutiles -->
      <div class="absolute inset-0 opacity-10 mix-blend-color-dodge bg-noise"></div>
      
      <div class="container relative z-10 px-4 text-center">
        <h2 class="text-4xl md:text-6xl font-black text-white mb-6 tracking-tighter uppercase leading-tight">
          {impacto?.title || "Eleva tu Operación"}
        </h2>
        <p class="text-lg md:text-xl text-slate-400 mb-10 max-w-2xl mx-auto font-light">
          {impacto?.description || "Inicia el cambio hacia una cadena de suministro ágil, resiliente y de clase mundial."}
        </p>
        
        <a href="#contact-form" class="inline-flex items-center gap-4 bg-yellow-400 text-[#0a192f] font-black uppercase tracking-widest px-8 md:px-10 py-4 hover:bg-yellow-300 transition-all duration-300 transform hover:scale-105 shadow-[0_10px_30px_rgba(250,204,21,0.2)]">
          <span>{impacto?.buttonText || "Solicitar Cotización"}</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
      </div>
    </section>

</div>

<style>
  .bg-noise {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
