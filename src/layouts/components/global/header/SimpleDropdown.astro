---
import { getLocaleUrlCTM } from "@/lib/utils/i18nUtils";
import type { NavigationLink } from "@/types";

interface Props {
  items: NavigationLink[];
  parentUrl?: string;
  parentName?: string;
  isMobile?: boolean;
}

const { items, parentUrl, parentName, isMobile } = Astro.props;
---

<div
  class="hs-dropdown-menu nav-dropdown-list top-full! mt-2! w-48! p-2! transition-all duration-300 ease-in-out before:absolute before:start-0 before:-top-6 before:h-6 before:w-full"
  aria-labelledby="hs-dropdown-hover-event">
  <div class="flex flex-col gap-1">
    {
      isMobile && parentUrl && (
        <div class="p-4 bg-neutral-50 dark:bg-neutral-800/50 -mx-2 -mt-2 mb-2 rounded-t-lg">
             <a
              class="flex items-center gap-2 font-semibold text-neutral-800 dark:text-neutral-200 hover:text-accent dark:hover:text-accent"
              href={getLocaleUrlCTM(parentUrl, Astro.currentLocale)}>
              Ver Todos
              <svg class="size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </a>
        </div>
      )
    }
    {
      items.map((child) => (
        <a
          class="nav-dropdown-link hover:text-accent! dark:hover:text-accent! px-3! py-2! hover:bg-transparent! transition-colors"
          href={getLocaleUrlCTM(child.url || "#", Astro.currentLocale)}>
          {child.name}
        </a>
      ))
    }
  </div>
</div>
