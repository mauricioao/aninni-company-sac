---
const serviceList = [
    { label: "Carga Nacional", value: "Carga Nacional" },
    { label: "Carga Última Milla", value: "Carga Última Milla" },
    { label: "Carga Proyecto", value: "Carga Proyecto" },
    { label: "Vehículos Particulares", value: "Vehículos Particulares" },
    { label: "Depósito Aduanero", value: "Depósito Aduanero" },
    { label: "Depósito Simple", value: "Depósito Simple" },
    { label: "Almacenaje (Aire Libre - Rack)", value: "Almacenaje" },
    { label: "Agencia de Aduana", value: "Agencia de Aduana" },
    { label: "Agencia de Carga", value: "Agencia de Carga" },
    { label: "Logística Integral", value: "Logística Integral" },
    { label: "Door to Door", value: "Door to Door" },
    { label: "Asesoría Comercio Exterior", value: "Asesoría Comercio Exterior" },
    { label: "Asesoría Contable/Admin", value: "Asesoría Contable" },
];
---

<div class="w-full max-w-4xl mx-auto mt-10 p-6 bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl shadow-2xl relative z-20">
  <h3 class="text-white text-lg font-medium mb-4 text-center md:text-left">¿Qué necesitas transportar hoy?</h3>
  <form class="flex flex-col md:flex-row gap-4">
    <div class="relative flex-grow">
      <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-white/60">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-container"><path d="M22 7.7c0-.6-.4-1.2-.8-1.5l-6.3-3.9a2.62 2.62 0 0 0-2.6 0L6 1.7c-.4.3-.8.9-.8 1.5v12.8c0 .6.4 1.2.8 1.5l6.3 3.9a2.62 2.62 0 0 0 2.6 0l6.3-3.9c.4-.3.8-.9.8-1.5Z"/><path d="M6 12h12"/><path d="M6 12 12 9l6 3"/><path d="M6 21V12.5"/><path d="M22 21.5V12"/><path d="M12 22v-9"/></svg>
      </div>
      <select 
        id="service-select" 
        class="bg-white/5 border border-white/20 text-white text-sm rounded-lg focus:ring-accent focus:border-accent block w-full pl-10 p-4 placeholder-white/50 backdrop-blur-sm appearance-none cursor-pointer hover:bg-white/10 transition-colors [&>option]:text-dark bg-none"
      >
        <option value="" class="bg-dark text-gray-300">Selecciona un servicio...</option>
        {serviceList.map((s) => (
          <option value={s.value} class="text-dark bg-white">{s.label}</option>
        ))}
      </select>
       <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-white/60">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down"><path d="m6 9 6 6 6-6"/></svg>
      </div>
    </div>
    
    <div class="relative w-full md:w-auto">
        <button 
            type="button"
            id="find-service-btn"
            class="w-full md:w-auto px-8 py-4 bg-accent hover:bg-accent/90 text-white font-bold rounded-lg shadow-lg hover:shadow-accent/50 transition-all duration-300 transform hover:-translate-y-1 flex items-center justify-center gap-2"
        >
            <span>Cotizar Ahora</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>
    </div>
  </form>
</div>

<script>
  const btn = document.getElementById('find-service-btn');
  const select = document.getElementById('service-select') as HTMLSelectElement;
  const phoneNumber = "51924204083"; // Replace with actual company number if known, otherwise generic

  btn?.addEventListener('click', () => {
    if (select && select.value) {
      const selectedService = select.value;
      const message = `Quiero información sobre el servicio de "${selectedService}", espero su pronta respuesta, gracias.`;
      const url = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
      window.open(url, '_blank');
    } else {
        // Highlight error or shake
        select.classList.add('ring-2', 'ring-red-500');
        setTimeout(() => select.classList.remove('ring-2', 'ring-red-500'), 500);
    }
  });
</script>
