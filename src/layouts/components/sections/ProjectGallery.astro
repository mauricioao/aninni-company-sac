---
import { Image } from "astro:assets";

// Import images directly
import img1 from "@/assets/images/gallery/1.jpg";
import img2 from "@/assets/images/gallery/2.jpg";
import img3 from "@/assets/images/gallery/3.jpg";
import img4 from "@/assets/images/gallery/4.jpg";
import img5 from "@/assets/images/gallery/5.jpg";
import img6 from "@/assets/images/gallery/6.jpg";
import img7 from "@/assets/images/gallery/7.jpg";
import img8 from "@/assets/images/gallery/8.jpg";

const projects = [
  { img: img1, title: "Gestión Logística Integral", subtitle: "Optimización de la cadena de suministro" },
  { img: img2, title: "Distribución de Repuestos", subtitle: "Suministro confiable de componentes" },
  { img: img3, title: "Transporte Especializado", subtitle: "Distribución eficiente a nivel nacional" },
  { img: img4, title: "Almacenamiento Seguro", subtitle: "Infraestructura moderna de alto nivel" },
  { img: img5, title: "Gestión Administrativa", subtitle: "Resolución de soluciones corporativas" },
  { img: img6, title: "Soporte Técnico Especializado", subtitle: "Atención y seguimiento 24/7" },
  { img: img7, title: "Innovación Tecnológica", subtitle: "Sistemas avanzados de operaciones" },
  { img: img8, title: "Proyectos a Medida", subtitle: "Adaptabilidad integral para tu empresa" }
];

---

<section class="gallery-section">
  <div class="gallery-header">
    <h1>Nuestros Proyectos</h1>
    <p>Explora nuestro portafolio de soluciones logísticas, corporativas y de suministro. Cada proyecto refleja nuestro pleno compromiso con la excelencia, la innovación tecnológica y el servicio personalizado, transformando los desafíos de nuestros clientes en resultados exitosos. Desliza para conocer más de nuestro trabajo y operaciones.</p>
  </div>

  <div class="carousel-container">
    <div class="carousel" id="carousel">
      {
        projects.map((project, index) => (
          <div class="carousel-item" data-index={index} data-full-src={project.img.src}>
            <Image
              src={project.img}
              alt={project.title}
              class="carousel-image"
              width={400}
              height={500}
            />
            <div class="carousel-overlay">
              <div class="overlay-content">
                <span class="carousel-title">{project.title}</span>
                <span class="carousel-subtitle">{project.subtitle}</span>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <div class="carousel-controls">
    <button id="prevBtn" class="carousel-btn" aria-label="Anterior">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
    </button>
    <button id="nextBtn" class="carousel-btn" aria-label="Siguiente">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
    </button>
  </div>


  <!-- Image Modal -->
  <div id="imageModal" class="modal">
    <button id="modalPrev" class="modal-nav modal-prev" aria-label="Anterior">&#10094;</button>
    <button id="modalNext" class="modal-nav modal-next" aria-label="Siguiente">&#10095;</button>
    <div class="modal-content">
      <button id="closeModal" class="modal-close" aria-label="Cerrar">&times;</button>
      <img id="modalImage" src="" alt="Vista ampliada" />
    </div>
  </div>
</section>

<style>
  .gallery-section {
    position: relative;
    width: 100%;
    min-height: 100vh; /* Removed to avoid gap with footer */
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start; /* Align to top to control spacing manually */
    overflow: hidden;
    padding: 6rem 1rem 0; /* More top space for title, no bottom padding */
  }

  .gallery-header {
    text-align: center;
    margin-bottom: 3rem;
    z-index: 10;
  }

  .gallery-header h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }

  .gallery-header p {
    font-size: 1.125rem;
    color: #9ca3af;
    font-weight: 400;
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .carousel-container {
    position: relative;
    width: 100%;
    height: 500px;
    perspective: 1200px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .carousel {
    position: relative;
    width: 200px;
    height: 300px;
    transform-style: preserve-3d;
    transition: transform 0.1s ease-out; /* Faster response for drag */
    cursor: grab;
  }

  .carousel:active {
    cursor: grabbing;
  }

  .carousel-item {
    position: absolute;
    top: 0;
    left: 0;
    width: 200px;
    height: 300px;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    transition: all 0.3s ease;
    backface-visibility: hidden;
  }

  .carousel-item:hover {
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.7);
  }

  .carousel-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .carousel-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.4) 70%, transparent 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: flex-end;
  }

  .carousel-item:hover .carousel-overlay {
    opacity: 1;
  }

  .overlay-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .carousel-title {
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 700;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
    line-height: 1.2;
  }

  .carousel-subtitle {
    color: #eab308;
    font-size: 0.875rem;
    font-weight: 500;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
  }

  .carousel-controls {
    display: flex;
    gap: 1rem;
    margin-top: 3rem;
    z-index: 10;
  }

  .carousel-btn {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .carousel-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .carousel-btn:active {
    transform: scale(0.95);
  }

  .carousel-btn svg {
    width: 24px;
    height: 24px;
  }

  @media (max-width: 768px) {
    .gallery-section {
      perspective: 800px; /* Closer perspective for mobile */
    }
    .carousel-container {
      height: 400px;
      perspective: 800px;
    }

    .carousel {
      width: 160px;
      height: 240px;
    }

    .carousel-item {
      width: 160px;
      height: 240px;
    }

    .gallery-header h1 {
      font-size: 2rem;
    }
  }

  /* Modal Styles */
  .modal {
    display: none;
    position: fixed;
    z-index: 99999; /* Very high z-index to ensure it's on top of everything */
    left: 0;
    top: 0;
    width: 100vw; /* Use viewport width */
    height: 100vh; /* Use viewport height */
    background-color: rgba(0, 0, 0, 0.98);
    backdrop-filter: blur(5px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .modal.show {
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 1;
  }

  .modal-content {
    position: relative;
    width: auto;
    height: auto;
    max-width: 98vw;
    max-height: 98vh;
    display: flex;
    justify-content: center;
    align-items: center;
    pointer-events: none; /* Let clicks pass through container to close */
  }

  .modal-content img {
    /* If image is small, scale it up. If huge, scale down. */
    width: auto;
    height: auto;
    max-width: 95vw;
    max-height: 95vh;
    object-fit: contain;
    border-radius: 4px; 
    box-shadow: 0 0 30px rgba(0, 0, 0, 0.8);
    pointer-events: auto; /* Re-enable clicks on image */
  }

  .modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    color: #f1f1f1;
    font-size: 30px;
    font-weight: bold;
    background: rgba(0, 0, 0, 0.5);
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 1001;
    transition: all 0.3s ease;
    line-height: 1;
    padding: 0;
    padding-bottom: 4px; /* Center the X visually */
    pointer-events: auto; 
  }

  .modal-close:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
  }

  .modal-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: none;
    font-size: 2rem;
    padding: 1rem;
    cursor: pointer;
    z-index: 1002;
    border-radius: 50%;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .modal-nav:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .modal-prev {
    left: 20px;
  }

  .modal-next {
    right: 20px;
  }

  @media (max-width: 768px) {
    .modal-close {
      top: 10px;
      right: 10px;
      width: 36px;
      height: 36px;
      font-size: 24px;
      background: rgba(0, 0, 0, 0.8); /* Darker background for mobile */
      border: 1px solid rgba(255, 255, 255, 0.5);
    }

    .modal-nav {
      width: 44px;
      height: 44px;
      font-size: 1.5rem;
      padding: 0;
    }

    .modal-prev {
      left: 10px;
    }

    .modal-next {
      right: 10px;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const carousel = document.getElementById("carousel") as HTMLElement;
    const items = document.querySelectorAll(".carousel-item") as NodeListOf<HTMLElement>;
    const prevBtn = document.getElementById("prevBtn");
    const nextBtn = document.getElementById("nextBtn");

    if (!carousel || !items.length) {
      return;
    }

    // Configuration
    const LERP_FACTOR = 0.1; // Smoothness (lower = smoother/slower)
    const DRAG_SENSITIVITY = 0.5;
    const MOMENTUM_FACTOR = 0.95; // Friction after release

    // State
    let currentAngle = 0;
    let targetAngle = 0;
    const totalItems = items.length;
    const angleStep = 360 / totalItems;
    let radius = 550; 

    // Drag State
    let isDragging = false;
    let lastTime = 0;

    // Zoom Modal Elements
    const modal = document.getElementById("imageModal");
    const modalImg = document.getElementById("modalImage") as HTMLImageElement;
    const closeModal = document.getElementById("closeModal");
    const modalPrev = document.getElementById("modalPrev");
    const modalNext = document.getElementById("modalNext");
    let currentModalIndex = -1;
    
    // Get all image sources for navigation - NOW USING FULL RESOLUTION
    const imageSources = Array.from(items).map(item => item.dataset.fullSrc || '');

    const updateRadius = () => {
      if (window.innerWidth < 768) {
        radius = 220; 
      } else {
        radius = 350; 
      }
      initCarousel();
    };

    const initCarousel = () => {
      items.forEach((item, index) => {
        const theta = (index * angleStep * Math.PI) / 180;
        const x = Math.sin(theta) * radius;
        const z = Math.cos(theta) * radius;
        item.style.transform = `translate3d(${x}px, 0, ${z}px) rotateY(${index * angleStep}deg)`;
        
        // Update click listener to check for drag vs click
        item.onclick = () => {
            // If significant movement occurred, treat as drag, not click
            if (Math.abs(velocity) > 0.5 || isDragging) return;
            openModal(index);
        };
      });
    };

    // Main Animation Loop
    const tick = () => {
      if (!isDragging) {
        // Apply momentum if any
        if (Math.abs(velocity) > 0.01) {
             targetAngle += velocity;
             velocity *= MOMENTUM_FACTOR;
        } else {
             // Optional: Snap to nearest slot when stopped
             // const snapped = Math.round(targetAngle / angleStep) * angleStep;
             // targetAngle += (snapped - targetAngle) * 0.1; 
        }
      }

      // Linear Interpolation
      const diff = targetAngle - currentAngle;
      
      // If far away, move closer
      // When very close, just set it to avoid infinite micro-updates? 
      // Actually standard lerp is fine, but for performance we can sleep if static.
      // For now, simple continuous lerp:
      currentAngle += diff * LERP_FACTOR;

      carousel.style.transform = `rotateY(${currentAngle}deg)`;
      
      requestAnimationFrame(tick);
    };

    // Start loop
    requestAnimationFrame(tick);

    // Controls
    const next = () => {
      // Move one full step relative to current approximate slot
      // Or just add step to target
      const currentSlot = Math.round(targetAngle / angleStep);
      targetAngle = (currentSlot - 1) * angleStep;
    };

    const prev = () => {
      const currentSlot = Math.round(targetAngle / angleStep);
      targetAngle = (currentSlot + 1) * angleStep;
    };

    // Drag Events
    const handleDragStart = (e: MouseEvent | TouchEvent) => {
      isDragging = true;
      lastX = startX;
      lastTime = Date.now();
      velocity = 0;
      
      carousel.style.cursor = 'grabbing';
      // Stop any snapping/momentum instantly implies targetAngle fixes on current?
      // Actually, we want to grab 'from where it is'. 
      // But to avoid jumping, 'targetAngle' should be reset to 'currentAngle' visually?
      // If we change targetAngle abruptly, lerp will jump? No, lerp will smooth it.
      // Better to keep targetAngle consistent with the visual grab point.
      // A common trick:
      // dist = currentAngle - startAngle;
      // We are just adding delta.
    };

    const handleDragMove = (e: MouseEvent | TouchEvent) => {
      if (!isDragging) return;
      e.preventDefault(); 
      
      const x = e instanceof MouseEvent ? e.clientX : e.touches[0].clientX;
      const dx = x - lastX;
      
      // Update target directly
      targetAngle += dx * DRAG_SENSITIVITY;
      
      // Calculate instantaneous velocity for throw
      const now = Date.now();
      const dt = now - lastTime;
      if (dt > 0) {
        velocity = (dx * DRAG_SENSITIVITY); 
        // Cap velocity?
      }

      lastX = x;
      lastTime = now;
    };

    const handleDragEnd = () => {
      if (!isDragging) return;
      isDragging = false;
      carousel.style.cursor = 'grab';
      
      // Snap logic: adjust targetAngle to nearest slot AFTER momentum?
      // Let's implement a simple "snap to effective target" 
      // Predict where it will land: 
      // land = targetAngle + (velocity / (1 - MOMENTUM_FACTOR)); 
      // const snap = Math.round(land / angleStep) * angleStep;
      // targetAngle = snap;
      // But let's verify if the user wants strict slots. 
      // The original code had slots. Let's do a soft snap.
      
      // We will leave velocity alone to let the 'tick' handle momentum, 
      // but we can add a 'snap' phase later in tick if we want strict slots.
      // For now, free spinning with momentum is smoother and feels better.
      // If you want strict snapping, uncomment this:
      /*
      const predictedEnd = targetAngle + (velocity * 10); // simplified projection
      const closestSlot = Math.round(predictedEnd / angleStep) * angleStep;
      // We can nudge velocity to get there, or just set targetAngle behavior in tick.
      */
      
      // Just ensure velocity isn't crazy
      if (Math.abs(velocity) > 5) velocity = 5 * Math.sign(velocity);
    };

    // ---- Event Binding ----

    if (nextBtn) nextBtn.addEventListener("click", next);
    if (prevBtn) prevBtn.addEventListener("click", prev);

    carousel.addEventListener('mousedown', handleDragStart);
    window.addEventListener('mousemove', handleDragMove);
    window.addEventListener('mouseup', handleDragEnd);
    window.addEventListener('mouseleave', handleDragEnd);

    carousel.addEventListener('touchstart', handleDragStart, { passive: false });
    window.addEventListener('touchmove', handleDragMove, { passive: false });
    window.addEventListener('touchend', handleDragEnd);


    // ---- Modal Logic (Unchanged mostly) ----
    const openModal = (index: number) => {
      if (!modal || !modalImg || index < 0 || index >= imageSources.length) return;
      currentModalIndex = index;
      updateModalImage();
      modal.style.display = 'flex';
      modal.offsetHeight; 
      modal.classList.add('show');
      document.body.style.overflow = 'hidden';
    };

    const updateModalImage = () => {
      if (currentModalIndex >= 0 && currentModalIndex < imageSources.length) {
        modalImg.src = imageSources[currentModalIndex];
      }
    };

    const nextModalImage = (e: Event) => {
      e.stopPropagation();
      currentModalIndex = (currentModalIndex + 1) % imageSources.length;
      updateModalImage();
    };

    const prevModalImage = (e: Event) => {
      e.stopPropagation();
      currentModalIndex = (currentModalIndex - 1 + imageSources.length) % imageSources.length;
      updateModalImage();
    };

    const closeModalFunc = () => {
      if (!modal) return;
      modal.classList.remove('show');
      setTimeout(() => {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      }, 300);
    };

    if (closeModal) closeModal.addEventListener('click', closeModalFunc);
    if (modal) {
        modal.addEventListener('click', (e) => {
            if (e.target === modal) closeModalFunc();
        });
    }
    if (modalNext) modalNext.addEventListener('click', nextModalImage);
    if (modalPrev) modalPrev.addEventListener('click', prevModalImage);

    document.addEventListener('keydown', (e) => {
        if (modal && modal.classList.contains('show')) {
            if (e.key === 'Escape') closeModalFunc();
            if (e.key === 'ArrowRight') nextModalImage(e);
            if (e.key === 'ArrowLeft') prevModalImage(e);
        } else {
             // Only nav carousel if modal not open
             if (e.key === "ArrowRight") next();
             if (e.key === "ArrowLeft") prev();
        }
    });

    window.addEventListener('resize', updateRadius);
    updateRadius(); 
  });
</script>
