---
import { Image } from "astro:assets";

// Import images directly
import img1 from "@/assets/images/gallery/1.jpg";
import img2 from "@/assets/images/gallery/2.jpg";
import img3 from "@/assets/images/gallery/3.jpg";
import img4 from "@/assets/images/gallery/4.jpg";
import img5 from "@/assets/images/gallery/5.jpg";
import img6 from "@/assets/images/gallery/6.jpg";
import img7 from "@/assets/images/gallery/7.jpg";
import img8 from "@/assets/images/gallery/8.jpg";

const imageList = [img1, img2, img3, img4, img5, img6, img7, img8];
// Duplicate images to ensure enough items for a full circle if needed, or just use as is.
// For a better 3D effect with 8 images, we might want to ensure they are spaced out well.

---

<section class="gallery-section">
  <div class="gallery-header">
    <h1>Nuestros Proyectos</h1>
    <p>Desliza para explorar</p>
  </div>

  <div class="carousel-container">
    <div class="carousel" id="carousel">
      {
        imageList.map((img, index) => (
          <div class="carousel-item" data-index={index}>
            <Image
              src={img}
              alt={`Proyecto ${index + 1}`}
              class="carousel-image"
              width={400}
              height={500}
            />
            <div class="carousel-overlay">
              <span class="carousel-title">Proyecto {index + 1}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <div class="carousel-controls">
    <button id="prevBtn" class="carousel-btn" aria-label="Anterior">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
    </button>
    <button id="nextBtn" class="carousel-btn" aria-label="Siguiente">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
    </button>
  </div>


  <!-- Image Modal -->
  <div id="imageModal" class="modal">
    <button id="modalPrev" class="modal-nav modal-prev" aria-label="Anterior">&#10094;</button>
    <button id="modalNext" class="modal-nav modal-next" aria-label="Siguiente">&#10095;</button>
    <div class="modal-content">
      <button id="closeModal" class="modal-close" aria-label="Cerrar">&times;</button>
      <img id="modalImage" src="" alt="Vista ampliada" />
    </div>
  </div>
</section>

<style>
  .gallery-section {
    position: relative;
    width: 100%;
    min-height: 100vh; /* Removed to avoid gap with footer */
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start; /* Align to top to control spacing manually */
    overflow: hidden;
    padding: 6rem 1rem 0; /* More top space for title, no bottom padding */
  }

  .gallery-header {
    text-align: center;
    margin-bottom: 3rem;
    z-index: 10;
  }

  .gallery-header h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }

  .gallery-header p {
    font-size: 1.125rem;
    color: #9ca3af;
    font-weight: 300;
  }

  .carousel-container {
    position: relative;
    width: 100%;
    height: 500px;
    perspective: 1200px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .carousel {
    position: relative;
    width: 200px;
    height: 300px;
    transform-style: preserve-3d;
    transition: transform 0.1s ease-out; /* Faster response for drag */
    cursor: grab;
  }

  .carousel:active {
    cursor: grabbing;
  }

  .carousel-item {
    position: absolute;
    top: 0;
    left: 0;
    width: 200px;
    height: 300px;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    transition: all 0.3s ease;
    backface-visibility: hidden;
  }

  .carousel-item:hover {
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.7);
  }

  .carousel-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .carousel-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: flex-end;
  }

  .carousel-item:hover .carousel-overlay {
    opacity: 1;
  }

  .carousel-title {
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 700;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
  }

  .carousel-controls {
    display: flex;
    gap: 1rem;
    margin-top: 3rem;
    z-index: 10;
  }

  .carousel-btn {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .carousel-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .carousel-btn:active {
    transform: scale(0.95);
  }

  .carousel-btn svg {
    width: 24px;
    height: 24px;
  }

  @media (max-width: 768px) {
    .gallery-section {
      perspective: 800px; /* Closer perspective for mobile */
    }
    .carousel-container {
      height: 400px;
      perspective: 800px;
    }

    .carousel {
      width: 160px;
      height: 240px;
    }

    .carousel-item {
      width: 160px;
      height: 240px;
    }

    .gallery-header h1 {
      font-size: 2rem;
    }
  }

  /* Modal Styles */
  .modal {
    display: none;
    position: fixed;
    z-index: 99999; /* Very high z-index to ensure it's on top of everything */
    left: 0;
    top: 0;
    width: 100vw; /* Use viewport width */
    height: 100vh; /* Use viewport height */
    background-color: rgba(0, 0, 0, 0.98);
    backdrop-filter: blur(5px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .modal.show {
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 1;
  }

  .modal-content {
    position: relative;
    max-width: 90%;
    max-height: 90%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .modal-content img {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
  }

  .modal-close {
    position: absolute;
    top: -20px;
    right: -20px;
    color: #f1f1f1;
    font-size: 30px;
    font-weight: bold;
    background: rgba(0, 0, 0, 0.5);
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 1001;
    transition: all 0.3s ease;
    line-height: 1;
    padding: 0;
    padding-bottom: 4px; /* Center the X visually */
  }

  .modal-close:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
  }

  .modal-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: none;
    font-size: 2rem;
    padding: 1rem;
    cursor: pointer;
    z-index: 1002;
    border-radius: 50%;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .modal-nav:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .modal-prev {
    left: 20px;
  }

  .modal-next {
    right: 20px;
  }

  @media (max-width: 768px) {
    .modal-close {
      top: -15px;
      right: -15px;
      width: 36px;
      height: 36px;
      font-size: 24px;
      background: rgba(0, 0, 0, 0.8); /* Darker background for mobile */
      border: 1px solid rgba(255, 255, 255, 0.5);
      left: auto; /* Reset left */
    }

    .modal-nav {
      width: 44px;
      height: 44px;
      font-size: 1.5rem;
      padding: 0;
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .modal-prev {
      left: 10px;
    }

    .modal-next {
      right: 10px;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const carousel = document.getElementById("carousel") as HTMLElement;
    const items = document.querySelectorAll(".carousel-item") as NodeListOf<HTMLElement>;
    const prevBtn = document.getElementById("prevBtn");
    const nextBtn = document.getElementById("nextBtn");

    if (!carousel || !items.length) {
      console.error("Carousel elements not found");
      return;
    }

    let currentAngle = 0;
    let targetAngle = 0;
    const totalItems = items.length;
    const angleStep = 360 / totalItems;
    let radius = 550; // Default radius

    // Drag state
    let isDragging = false;
    let startX = 0;
    let velocity = 0;
    let lastX = 0;
    let lastTime = 0;
    let animationId: number;

    // Zoom Modal Elements
    const modal = document.getElementById("imageModal");
    const modalImg = document.getElementById("modalImage") as HTMLImageElement;
    const closeModal = document.getElementById("closeModal");
    const modalPrev = document.getElementById("modalPrev");
    const modalNext = document.getElementById("modalNext");
    
    let currentModalIndex = -1;
    // Get all image sources for navigation
    const imageSources = Array.from(items).map(item => item.querySelector('img')?.src || '');

    // Responsive radius
    const updateRadius = () => {
      if (window.innerWidth < 768) {
        radius = 220; // Smaller radius for mobile
      } else {
        radius = 350; // Reduced radius for desktop
      }
      initCarousel();
    };

    // Initialize carousel items in 3D circle
    const initCarousel = () => {
      items.forEach((item, index) => {
        const theta = (index * angleStep * Math.PI) / 180;
        const x = Math.sin(theta) * radius;
        const z = Math.cos(theta) * radius;
        
        // Adjust rotation to face outward correctly
        item.style.transform = `translate3d(${x}px, 0, ${z}px) rotateY(${index * angleStep}deg)`;
        
        // Add click listener for zoom
        item.addEventListener('click', () => {
          if (!isDragging && Math.abs(velocity) < 0.1) { // Only open if not dragging
             openModal(index);
          }
        });
      });
    };

    // Rotate carousel
    const rotateCarousel = () => {
      carousel.style.transform = `rotateY(${currentAngle}deg)`;
    };

    // Inertia Animation Loop
    const animate = () => {
      if (isDragging) return;

      if (Math.abs(velocity) > 0.01) {
        currentAngle += velocity;
        velocity *= 0.95; // Friction
        rotateCarousel();
        animationId = requestAnimationFrame(animate);
      } else {
        // Snap to nearest
        snapToNearest();
      }
    };

    const snapToNearest = () => {
       const remainder = currentAngle % angleStep;
       if (Math.abs(remainder) > 0.1) {
          // Simple snap logic could go here if strict snapping is desired after inertia
          // For now, let's just stop smoothly
       }
    };

    // Smooth rotation to target
    const smoothRotateToTarget = () => {
      if (isDragging) return;
      
      // Simple lerp
      const diff = targetAngle - currentAngle;
      
      if (Math.abs(diff) > 0.5) {
        currentAngle += diff * 0.1; // Adjust 0.1 for speed
        rotateCarousel();
        animationId = requestAnimationFrame(smoothRotateToTarget);
      } else {
        currentAngle = targetAngle;
        rotateCarousel();
      }
    };

    // Navigation functions
    const next = () => {
      targetAngle -= angleStep;
      cancelAnimationFrame(animationId);
      smoothRotateToTarget();
    };

    const prev = () => {
      targetAngle += angleStep;
      cancelAnimationFrame(animationId);
      smoothRotateToTarget();
    };

    // Drag Events
    const handleDragStart = (e: MouseEvent | TouchEvent) => {
      isDragging = true;
      cancelAnimationFrame(animationId);
      
      startX = e instanceof MouseEvent ? e.clientX : e.touches[0].clientX;
      lastX = startX;
      lastTime = Date.now();
      velocity = 0;
      
      carousel.style.transition = 'none';
      carousel.style.cursor = 'grabbing';
    };

    const handleDragMove = (e: MouseEvent | TouchEvent) => {
      if (!isDragging) return;
      e.preventDefault(); // Prevent scrolling on touch
      
      const x = e instanceof MouseEvent ? e.clientX : e.touches[0].clientX;
      const now = Date.now();
      const dt = now - lastTime;
      const dx = x - lastX;
      
      const sensitivity = 0.5;
      currentAngle += dx * sensitivity;
      rotateCarousel();

      // Calculate velocity
      if (dt > 0) {
        velocity = (dx * sensitivity); // Simple velocity
      }

      lastX = x;
      lastTime = now;
    };

    const handleDragEnd = () => {
      if (!isDragging) return;
      isDragging = false;
      carousel.style.cursor = 'grab';
      
      // Start inertia
      animate();
    };

    // Modal Functions
    const openModal = (index: number) => {
      if (!modal || !modalImg || index < 0 || index >= imageSources.length) return;
      
      currentModalIndex = index;
      updateModalImage();
      
      modal.style.display = 'flex';
      // Trigger reflow
      modal.offsetHeight; 
      modal.classList.add('show');
      document.body.style.overflow = 'hidden'; // Prevent background scrolling
    };

    const updateModalImage = () => {
      if (currentModalIndex >= 0 && currentModalIndex < imageSources.length) {
        modalImg.src = imageSources[currentModalIndex];
      }
    };

    const nextModalImage = (e: Event) => {
      e.stopPropagation();
      currentModalIndex = (currentModalIndex + 1) % imageSources.length;
      updateModalImage();
    };

    const prevModalImage = (e: Event) => {
      e.stopPropagation();
      currentModalIndex = (currentModalIndex - 1 + imageSources.length) % imageSources.length;
      updateModalImage();
    };

    const closeModalFunc = () => {
      if (!modal) return;
      modal.classList.remove('show');
      setTimeout(() => {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      }, 300);
    };

    // Event listeners
    if (nextBtn) nextBtn.addEventListener("click", next);
    if (prevBtn) prevBtn.addEventListener("click", prev);

    // Mouse events
    carousel.addEventListener('mousedown', handleDragStart);
    window.addEventListener('mousemove', handleDragMove);
    window.addEventListener('mouseup', handleDragEnd);
    window.addEventListener('mouseleave', handleDragEnd);

    // Touch events
    carousel.addEventListener('touchstart', handleDragStart, { passive: false });
    window.addEventListener('touchmove', handleDragMove, { passive: false });
    window.addEventListener('touchend', handleDragEnd);

    // Modal Events
    if (closeModal) closeModal.addEventListener('click', closeModalFunc);
    if (modal) {
        modal.addEventListener('click', (e) => {
            if (e.target === modal) closeModalFunc();
        });
    }
    if (modalNext) modalNext.addEventListener('click', nextModalImage);
    if (modalPrev) modalPrev.addEventListener('click', prevModalImage);

    document.addEventListener('keydown', (e) => {
        if (!modal || !modal.classList.contains('show')) return;
        
        if (e.key === 'Escape') closeModalFunc();
        if (e.key === 'ArrowRight') nextModalImage(e);
        if (e.key === 'ArrowLeft') prevModalImage(e);
    });

    // Keyboard navigation
    document.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") next();
      if (e.key === "ArrowLeft") prev();
    });

    // Resize listener
    window.addEventListener('resize', updateRadius);

    // Initialize
    updateRadius(); // Sets initial radius and positions
    rotateCarousel();
  });
</script>
