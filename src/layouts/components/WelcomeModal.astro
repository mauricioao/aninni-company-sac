---
import { getLocaleUrlCTM } from "@/lib/utils/i18nUtils";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";

const lang = Astro.props.lang || Astro.currentLocale;
---

<div id="welcome-modal" class="fixed inset-0 z-[9999] hidden flex items-center justify-center p-4 backdrop-blur-sm bg-black/60 opacity-0 transition-opacity duration-300" role="dialog" aria-modal="true">
  
  <div class="relative w-full max-w-3xl transform overflow-hidden rounded-2xl bg-white text-left shadow-2xl transition-all scale-95 duration-300" id="modal-content">
    
    <!-- Close Button -->
    <button type="button" class="absolute top-4 right-4 z-10 p-2 text-gray-400 hover:text-gray-600 transition-colors rounded-full hover:bg-gray-100" id="close-modal">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="flex flex-col md:flex-row">
       <!-- Left Side: Image/Visual (Optional, promoting brand) -->
       <div class="hidden md:block md:w-2/5 bg-gray-50 relative overflow-hidden">
           <div class="absolute inset-0 bg-gradient-to-br from-blue-600/10 to-transparent z-10"></div>
           <!-- Decorative Pattern -->
           <svg class="absolute top-0 left-0 w-full h-full opacity-10" width="100%" height="100%">
               <pattern id="grid-pattern" width="40" height="40" patternUnits="userSpaceOnUse">
                   <path d="M0 40L40 0H20L0 20M40 40V20L20 40" stroke="currentColor" stroke-width="2" fill="none" class="text-blue-500"/>
               </pattern>
               <rect width="100%" height="100%" fill="url(#grid-pattern)" />
           </svg>
           
           <div class="absolute inset-0 flex items-center justify-center z-20 p-8">
                <!-- Large Icon/Illustration -->
                <OptimizedImage
                  src="/images/logos/LOGO ANINNI COMPANY01_SINFONDO.png"
                  alt="Aninni Logo"
                  width={240}
                  height={240}
                  class="w-full h-auto object-contain drop-shadow-xl" 
                />
           </div>
       </div>

       <!-- Right Side: Content -->
       <div class="w-full md:w-3/5 p-8 md:p-10 flex flex-col justify-center relative">
          <!-- Subtle Glow Effect Behind Text -->
          <div class="absolute -top-10 -right-10 w-40 h-40 bg-blue-100/50 rounded-full blur-3xl -z-10"></div>
          
          <div class="text-center md:text-left mb-8 relative">
              <span class="inline-block py-1.5 px-4 rounded-full bg-blue-50 text-blue-600 border border-blue-100 text-xs font-bold tracking-widest uppercase mb-4 shadow-sm">Bienvenido</span>
              <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 leading-tight mb-3 tracking-tight">
                  Aninni Company <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-500">S.A.C.</span>
              </h2>
              <p class="text-gray-600 text-sm md:text-base max-w-md mx-auto md:mx-0">
                  Impulsamos el éxito de su negocio con soluciones logísticas integrales, modernas y de alta calidad.
              </p>
          </div>

          <!-- Feature Focus -->
          <div class="mb-8 transform transition-transform hover:-translate-y-1">
              <!-- Services Option -->
              <a href={getLocaleUrlCTM("/services", lang)} class="group relative flex flex-col md:flex-row items-center md:items-start p-6 border border-gray-100 shadow-sm rounded-2xl hover:border-blue-400 hover:shadow-xl hover:shadow-blue-500/10 transition-all duration-300 bg-white overflow-hidden text-center md:text-left" onclick="closeModal()">
                  <!-- Subtle background gradient on hover -->
                  <div class="absolute inset-0 bg-gradient-to-r from-blue-50/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                  
                  <div class="relative w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-100 to-blue-50 border border-blue-100 flex items-center justify-center text-blue-600 mb-4 md:mb-0 md:mr-5 group-hover:scale-110 group-hover:rotate-3 transition-transform duration-300 shrink-0 shadow-sm">
                      <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                  </div>
                  <div class="relative flex-1">
                      <h3 class="font-bold text-gray-900 text-lg mb-1 group-hover:text-blue-700 transition-colors">Nuestros Servicios</h3>
                      <p class="text-sm text-gray-500 mb-3 leading-relaxed">Explora nuestras soluciones en Transporte, Almacenaje, Aduanas y Asesoría estructurada para tu empresa.</p>
                      <span class="inline-flex items-center text-blue-600 text-sm font-semibold group-hover:translate-x-1 transition-transform">
                          Explorar Servicios
                          <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                      </span>
                  </div>
              </a>
          </div>

          <!-- Footer/Note -->
          <div class="text-center pt-5 border-t border-gray-100">
             <button id="cta-dismiss" class="text-sm text-gray-400 hover:text-gray-800 transition-colors font-medium">
                 Continuar al sitio
             </button>
          </div>
       </div>
    </div>
  </div>
</div>

<script is:inline>
  // Expose close function to window for inline onclicks
  window.closeModal = function() {
      const modal = document.getElementById('welcome-modal');
      const modalContent = document.getElementById('modal-content');
      
      if(modal && modalContent) {
          modal.classList.add('opacity-0');
          modalContent.classList.remove('scale-100');
          modalContent.classList.add('scale-95');
          setTimeout(() => {
              modal.classList.add('hidden');
          }, 300);
      }
  }

  document.addEventListener('astro:page-load', () => {
      initWelcomeModal();
  });
  
  document.addEventListener('DOMContentLoaded', () => {
      initWelcomeModal();
  });

  function initWelcomeModal() {
      const modal = document.getElementById('welcome-modal');
      const modalContent = document.getElementById('modal-content');
      const closeBtn = document.getElementById('close-modal');
      const ctaDismiss = document.getElementById('cta-dismiss');
      
      if (!modal) return;

      // Always show modal (removed sessionStorage check)
      modal.classList.remove('hidden');
      requestAnimationFrame(() => {
          modal.classList.remove('opacity-0');
          modalContent.classList.remove('scale-95');
          modalContent.classList.add('scale-100');
      });

      closeBtn?.addEventListener('click', window.closeModal);
      ctaDismiss?.addEventListener('click', window.closeModal);
      
      // Close on backdrop click (optional, maybe user wants it forced? Keeping it strictly friendly for now)
      modal.addEventListener('click', (e) => {
          if (e.target === modal) window.closeModal();
      });
  }
</script>
