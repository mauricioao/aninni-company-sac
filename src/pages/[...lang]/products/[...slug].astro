---
import Base from "@/layouts/Base.astro";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import { getCollectionCTM } from "@/lib/customContentLoader.astro";
import { supportedLanguages, getLocaleUrlCTM } from "@/lib/utils/i18nUtils";
import { parseTomlToJson } from "@/lib/utils/tomlUtils";

export async function getStaticPaths() {
  const paths = await Promise.all(
    supportedLanguages.map(async (lang) => {
      const config = parseTomlToJson();
      const { defaultLanguage, showDefaultLangInUrl } = config.settings.multilingual;

      let products = await getCollectionCTM("products", lang.languageCode);

      return products.map((product) => ({
        params: {
          lang:
            lang.languageCode === defaultLanguage && !showDefaultLangInUrl
              ? undefined
              : lang.languageCode,
          slug: product.id.split("/").pop()?.replace(/\.(mdx?|MDX?)$/, ""),
        },
        props: { 
            product,
            lang: lang.languageCode 
        },
      }));
    }),
  );

  return paths.flat();
}

const { product, lang } = Astro.props;
const { Content } = await product.render();
---

<Base
  title={product.data.title}
  description={product.data.description}
  image={product.data.image}>
  
  <!-- Header -->
  <section class="relative h-[40vh] min-h-[300px] w-full overflow-hidden bg-black">
    {product.data.image && (
        <div class="absolute inset-0 z-0">
         <OptimizedImage
            src={product.data.image}
            alt={product.data.title}
            width={1920}
            height={1080}
            class="h-full w-full object-cover opacity-60"
         />
        </div>
    )}
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-linear-to-t from-black via-black/50 to-transparent">
      </div>
    </div>
    <div class="relative z-10 container flex h-full flex-col justify-center">
      <h1 class="text-4xl font-bold text-white md:text-6xl max-w-4xl">
        {product.data.title}
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-white/90 font-medium">
        {product.data.description}
      </p>
    </div>
  </section>

  <!-- Main Content with Sidebar -->
  <section class="py-12 bg-white text-neutral-900">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row gap-12 pt-4">
        
        <!-- Sidebar -->
        <aside class="w-full lg:w-64 shrink-0 space-y-10">
            <!-- Search -->
            <div class="relative group">
                <input id="product-search" type="text" placeholder="Search products..." class="w-full pl-5 pr-12 py-3 rounded-full border border-neutral-200 bg-neutral-100/50 outline-none transition-all duration-300 focus:bg-white focus:border-neutral-300 focus:shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:bg-white text-sm text-neutral-900 placeholder:text-neutral-400" />
                <div class="absolute right-4 top-1/2 -translate-y-1/2 text-neutral-400 group-focus-within:text-neutral-800 transition-colors duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                    </svg>
                </div>
            </div>

            <!-- Categories -->
            <div>
                <div class="flex justify-between items-center mb-4 cursor-pointer group">
                    <h3 class="font-bold text-sm uppercase tracking-wide text-neutral-900">Categorías</h3>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-neutral-500 group-hover:text-black transition-colors">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 15.75 7.5-7.5 7.5 7.5" />
                    </svg>
                </div>
                <div class="space-y-3 pl-1">
                    <a href={getLocaleUrlCTM("/products/repuestos-motos", lang)} class:list={["flex items-center gap-3 text-sm transition-colors", product.slug.includes("repuestos-motos") ? "text-black font-medium" : "text-neutral-500 hover:text-black"]}>
                        <div class:list={["w-4 h-4 border rounded relative flex items-center justify-center", product.slug.includes("repuestos-motos") ? "border-black bg-black" : "border-neutral-300"]}>
                            {product.slug.includes("repuestos-motos") && <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7"></path></svg>}
                        </div>
                        Repuestos para Motos
                    </a>
                </div>
            </div>
        </aside>

        <!-- Product Grid Area -->
        <main class="flex-1">
             <!-- Content Description -->
            <div class="prose prose-lg max-w-none mb-10 text-neutral-600">
                <Content />
            </div>

            {product.data.items && product.data.items.length > 0 ? (
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10" id="product-grid">
                    {product.data.items.map((item) => {
                         // Debug log to verify what is actually coming from the Markdown/Content Collection
                        console.log(`Item: ${item.name}, Stock Value:`, item.stock, `Type:`, typeof item.stock);
                        
                        // Robust check for stock status (handle boolean or string "false")
                        const isOutOfStock = item.stock === false || String(item.stock) === "false";
                        const hasStock = !isOutOfStock;
                        
                        return (
                        <div class:list={["group product-card relative border rounded-2xl p-4 transition-all duration-300 flex flex-col h-full", hasStock ? "bg-white hover:border-neutral-300 hover:shadow-sm" : "bg-neutral-50 border-neutral-100 opacity-50 grayscale pointer-events-none select-none"]} data-name={item.name.toLowerCase()}>
                            
                            {/* Stock Badge - Explicitly rendered if out of stock - REMOVED PER USER REQUEST */}
                            
                            <!-- Image Container -->
                            <div class:list={["relative w-full aspect-4/3 rounded-xl mb-4 overflow-hidden flex items-center justify-center p-2 flex-shrink-0 bg-white", !hasStock && "grayscale"]}>
                                {item.image ? (
                                     <OptimizedImage
                                        src={item.image}
                                        alt={item.name}
                                        width={300}
                                        height={300}
                                        class="w-auto h-full max-h-[160px] object-contain transition-transform duration-500 group-hover:scale-105"
                                     />
                                ) : (
                                    <div class="w-20 h-20 text-neutral-300">
                                         <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-full h-full">
                                          <path stroke-linecap="round" stroke-linejoin="round" d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
                                        </svg>
                                    </div>
                                )}
                                
                                {/* Stock Status Badge */}
                                <div class:list={["absolute bottom-2 left-2 text-[10px] font-bold px-2 py-1 rounded text-white z-20", hasStock ? "bg-neutral-600" : "bg-neutral-400"]}>
                                    {hasStock ? "Con Stock" : "Sin Stock"}
                                </div>
                            </div>
                            
                            <!-- Content -->
                            <div class="flex flex-col flex-1">
                                <h3 class:list={["font-bold text-base md:text-lg leading-tight", hasStock ? "text-neutral-900" : "text-neutral-500"]}>
                                    {item.name}
                                </h3>
                                <p class="text-sm text-neutral-500 mt-1 line-clamp-2 mb-4">
                                    {item.description}
                                </p>
                                
                                {product.slug.includes('repuestos-motos') && hasStock && (
                                  <div class="mt-auto">
                                        <div class="quantity-selector" data-item-name={item.name}>
                                            <div class="qty-btn minus">-</div>
                                            <input type="text" readonly value="0" class="qty-input" />
                                            <div class="qty-btn plus">+</div>
                                        </div>
                                  </div>
                                )}
                            </div>
                        </div>
                    )})}
                    <div id="no-results" class="hidden col-span-full py-10 text-center text-neutral-500">
                        No se encontraron productos que coincidan con tu búsqueda.
                    </div>
                </div>
            ) : (
                <div class="text-center py-20">
                    <p class="text-neutral-500 text-lg">No Items Found.</p>
                </div>
            )}
        </main>
        
        <!-- Floating Quote Button -->
        <button id="whatsapp-quote-btn" class="floating-cart-btn cursor-pointer border-none outline-none">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
          Cotizar Productos
          <span class="cart-count">0</span>
        </button>

      </div>
    </div>
  </section>

<style>
  /* Quantity Selector Styles */
  .quantity-selector {
    display: flex;
    align-items: center;
    border: 1px solid #e5e5e5;
    border-radius: 9999px;
    padding: 0.25rem;
    width: fit-content;
    margin-top: 1rem;
    background-color: white;
  }
  
  .qty-btn {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f3f4f6;
    color: #374151;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.2s;
    user-select: none;
  }
  
  .qty-btn:hover {
    background-color: #e5e7eb;
    color: black;
  }
  
  .qty-input {
    width: 2.5rem;
    text-align: center;
    border: none;
    outline: none;
    font-weight: 600;
    color: #111827;
    background: transparent;
  }

  /* Floating Cart Button Styles */
  .floating-cart-btn {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 50;
    background-color: #25D366; /* WhatsApp Green */
    color: white;
    padding: 1rem 1.5rem;
    border-radius: 9999px;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 600;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    transform: translateY(200%); /* Hidden by default */
  }

  .floating-cart-btn.visible {
    transform: translateY(0);
  }

  .floating-cart-btn:hover {
    background-color: #20bd5a;
    transform: scale(1.05);
  }
  
  .cart-count {
    background-color: white;
    color: #25D366;
    border-radius: 9999px;
    padding: 0.1rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 800;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Search Functionality
    const searchInput = document.getElementById('product-search');
    const productCards = document.querySelectorAll('.product-card');
    const noResultsMsg = document.getElementById('no-results');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const searchTerm = e.target.value.toLowerCase().trim();
        let hasVisibleItems = false;

        productCards.forEach((card) => {
          const name = card.dataset.name || '';
          if (name.includes(searchTerm)) {
            card.style.display = 'block'; // Ensure block display for grid items
            hasVisibleItems = true;
          } else {
            card.style.display = 'none';
          }
        });

        if (noResultsMsg) {
            if (hasVisibleItems) {
                noResultsMsg.classList.add('hidden');
            } else {
                noResultsMsg.classList.remove('hidden');
            }
        }
      });
    }

    // Cart / Quote Functionality
    const cart = new Map(); // Store item name -> quantity
    const selectors = document.querySelectorAll('.quantity-selector');
    const quoteBtn = document.getElementById('whatsapp-quote-btn');
    const countBadge = document.querySelector('.cart-count');
    const whatsappNumber = "51924204083"; 

    function updateCartUI() {
      if (!quoteBtn || !countBadge) return;

      let totalItems = 0;
      cart.forEach((qty) => {
        if (qty > 0) totalItems += 1;
      });

      countBadge.textContent = totalItems;
      
      const globalWhatsappBtn = document.querySelector('.whatsapp-btn');
      
      if (totalItems > 0) {
        quoteBtn.classList.add('visible');
        if (globalWhatsappBtn) {
            globalWhatsappBtn.classList.add('scale-0', 'opacity-0', 'pointer-events-none');
        }
      } else {
        quoteBtn.classList.remove('visible');
        if (globalWhatsappBtn) {
            globalWhatsappBtn.classList.remove('scale-0', 'opacity-0', 'pointer-events-none');
        }
      }
    }
    
    // Add Click Handler for Quote Button (Generate URL on demand)
    if (quoteBtn) {
        quoteBtn.addEventListener('click', (e) => {
            e.preventDefault();
            
            let message = "Saludos Annini Company, quisiera cotizar los siguiente productos:\n\n";
            let hasItems = false;
            
            cart.forEach((qty, name) => {
                const quantity = parseInt(String(qty), 10);
                if (!isNaN(quantity) && quantity > 0) {
                    // Cleaner format: "- Name: 5"
                    message += `- ${name}: ${quantity}\n`;
                    hasItems = true;
                }
            });
            
            message += "\nMuchas gracias.";
            
            if (hasItems) {
                const url = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
                window.open(url, '_blank');
            }
        });
    }

    selectors.forEach(selector => {
      const minusBtn = selector.querySelector('.minus');
      const plusBtn = selector.querySelector('.plus');
      const input = selector.querySelector('.qty-input');
      const itemName = selector.dataset.itemName;

      if (!minusBtn || !plusBtn || !input || !itemName) return;

      const updateQty = (delta) => {
        let currentQty = parseInt(input.value) || 0;
        let newQty = Math.max(0, currentQty + delta);
        
        input.value = newQty;
        
        if (newQty > 0) {
            cart.set(itemName, newQty);
            selector.closest('.product-card').classList.add('border-neutral-400', 'bg-neutral-50');
        } else {
            cart.delete(itemName);
            selector.closest('.product-card').classList.remove('border-neutral-400', 'bg-neutral-50');
        }
        
        updateCartUI();
      };

      minusBtn.addEventListener('click', (e) => {
        e.stopPropagation(); 
        updateQty(-1);
      });

      plusBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        updateQty(1);
      });
      
      input.addEventListener('click', (e) => e.stopPropagation());
    });
  });
</script>
</Base>
